---
import Site from '../../layouts/Site.astro';
import {livingEpisodes,type LivingEpisode} from '../../lib/living-episodes';
import '../../styles/tales.css';
export function getStaticPaths(){return livingEpisodes.map(e=>({params:{slug:e.slug},props:{episode:e}}));}
interface Props {episode:LivingEpisode}
const {episode:e}=Astro.props;
const tale=e.body;
---
<Site title={tale.title} description={e.deck} active="Stories">
  <article class="tale-reader wrap">
    <header class="tale-reader-head">
      <a href="/tales/">← Stories &amp; Living Memories</a>
      <p class="kicker">{e.world.toUpperCase()} · PRIVATE STORY PREVIEW</p>
      <h1>{tale.title}</h1>
      <p class="lead">{e.deck}</p>
      <p class="fine">{tale.words} words · Six chapters · For secondary students and curious adults</p>
      <p class="tale-disclosure"><strong>Story type:</strong> {e.genre}. {e.fictionalStatus}</p>
      <nav class="tale-chapters" aria-label="Story chapters">
        <p class="kicker">FIND A CHAPTER</p>
        <ol>{tale.chapters.map(chapter=><li><a href={`#${chapter.id}`}>{chapter.number}. {chapter.title}</a></li>)}</ol>
      </nav>
    </header>
    <div class="tale-paper">
      {tale.chapters.map(chapter=><section class="tale-chapter" id={chapter.id}>
        <p class="kicker">CHAPTER {chapter.number} / 6</p><h2>{chapter.title}</h2>
        {chapter.passages.map(p=><p>{p.segments.map(s=>s.strong?<strong>{s.text}</strong>:s.italic?<em>{s.text}</em>:s.text)}</p>)}
      </section>)}
    </div>
    <footer class="tale-outro">
      <p class="kicker">ONE STORY · MORE THAN ONE VOICE</p>
      <h2>How was this story told to you?</h2>
      <p>{e.question} Families and communities may explain the same account differently. We want to preserve those differences with permission and attribution, not vote on a single official version.</p>
      <p class="fine">This is an invitation for future participation, not a working form. No submission, personal data or audio is collected on this preview.</p>
      <p class="tale-discuss"><strong>Classroom conversation:</strong> What did the characters think they knew? What could another viewpoint add? Who would you ask next?</p>
      <p><a href={"/community/share/?story="+e.slug}>Practise telling another version (private demo; nothing is submitted) →</a></p>
      <a href="/tales/">Explore other tales →</a>
      <p><a href={e.slug==='esu-hat-two-views'?'/figures/esu/':'/figures/olodumare/'}>Learn who this figure is and what Yorùbá traditions say →</a></p>
      <p class="fine">This written version has no matching narrated audio yet.</p>
    </footer>
  </article>
</Site>
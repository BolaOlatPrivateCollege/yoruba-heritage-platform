---
import Site from '../../layouts/Site.astro';
import {illustratedOgun} from '../../lib/ogun-story-art';
import {approvedFigureIllustrations} from '../../lib/approved-figure-illustrations';
import {existsSync} from 'node:fs';
import {resolve} from 'node:path';
const availableArt=(slug:string)=>{const a=approvedFigureIllustrations[slug];return a&&existsSync(resolve(process.cwd(),'public','images',a.filename))?a:undefined;};
import {livingEpisodes,type LivingEpisode} from '../../lib/living-episodes';
import '../../styles/tales.css';
export function getStaticPaths(){return livingEpisodes.map(e=>({params:{slug:e.slug},props:{episode:e}}));}
interface Props {episode:LivingEpisode}
const {episode:e}=Astro.props;
const tale=e.body;
const storyArt:Record<string,string>={'esu-hat-two-views':'esu','moremi-fire-in-the-reeds':'moremi-ajasoro','sango-when-thunder-answered':'sango','ogun-path-nobody-could-open':'ogun','osun-when-the-world-forgot-her':'osun','yemoja-river-that-remembered':'yemoja','olokun-secrets-beneath-the-water':'olokun'};
const illustrated=illustratedOgun(e.slug);
const art=illustrated?.cover??availableArt(storyArt[e.slug]??'');
const nextStory=livingEpisodes[(livingEpisodes.findIndex(item=>item.slug===e.slug)+1)%livingEpisodes.length]??e;
const relatedFigure=e.slug==='olokun-secrets-beneath-the-water'?{href:'/figures/olokun/',name:'Olókun'}:e.slug==='oya-before-the-wind-changed'?{href:'/figures/oya/',name:'Ọya'}:e.slug==='yemoja-river-that-remembered'?{href:'/figures/yemoja/',name:'Yemọja'}:e.slug==='osun-when-the-world-forgot-her'?{href:'/figures/osun/',name:'Ọ̀ṣun'}:e.slug==='ogun-path-nobody-could-open'?{href:'/figures/ogun/',name:'Ògún'}:e.slug==='esu-hat-two-views'?{href:'/figures/esu/',name:'Èṣù'}:e.slug==='olodumare-many-meanings'?{href:'/figures/olodumare/',name:'Olódùmarè'}:null;
---
<Site title={tale.title} description={e.deck} active="Stories">
  <article class="tale-reader wrap">
    <header class="tale-reader-head">
      <a href="/tales/">← Stories &amp; Living Memories</a>
      <p class="kicker">{e.world.toUpperCase()} · PRIVATE STORY PREVIEW</p>
      <h1>{tale.title}</h1>
      <p class="lead">{e.deck}</p>
      <p class="fine">{tale.words} words · Six chapters · For curious minds of every generation</p>
      <p class="tale-disclosure"><strong>Story type:</strong> {e.genre}. {e.fictionalStatus}</p>
      <nav class="tale-chapters" id="chapter-index" aria-label="Story chapters">
        <p class="kicker">FIND A CHAPTER</p>
        <ol>{tale.chapters.map(chapter=><li><a href={`#${chapter.id}`}>{chapter.number}. {chapter.title}</a></li>)}</ol>
      </nav>
    </header>
    {art&&<figure style="max-width:560px;margin:1rem auto 2rem"><img src={`/images/${art.filename}`} alt={art.alt} width={art.width} height={art.height} loading="lazy" decoding="async" style="width:100%;height:auto"/><figcaption class="fine">{art.caption}</figcaption></figure>}
    <div class="tale-paper">
      {tale.chapters.map((chapter,index)=><section class="tale-chapter" id={chapter.id}>
        <p class="kicker">CHAPTER {chapter.number} / 6</p><h2>{chapter.title}</h2>
        {illustrated&&illustrated.chapters[index]&&<figure class="tale-scene" style="margin:1.5rem 0"><img src={'/images/'+illustrated.chapters[index]!.filename} alt={illustrated.chapters[index]!.alt} width={1600} height={900} loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:8px"/><figcaption class="fine">{illustrated.chapters[index]!.caption}</figcaption></figure>}
        {chapter.passages.map(p=><p>{p.segments.map(s=>s.strong?<strong>{s.text}</strong>:s.italic?<em>{s.text}</em>:s.text)}</p>)}
        <nav class="tale-chapter-next" aria-label={`Navigation after chapter ${chapter.number}`}>
          {index>0&&<a href={`#${tale.chapters[index-1]?.id}`} aria-label={`Previous chapter: ${tale.chapters[index-1]?.title}`}>← Previous chapter</a>}
          <a href="#chapter-index">Chapter index ↑</a>
          {index<tale.chapters.length-1&&<a href={`#${tale.chapters[index+1]?.id}`} aria-label={`Next chapter: ${tale.chapters[index+1]?.title}`}>Next chapter →</a>}
        </nav>
      </section>)}
    </div>
    <footer class="tale-outro">
      <p class="kicker">ONE STORY · MORE THAN ONE VOICE</p>
      <h2>How was this story told to you?</h2>
      <p>{e.question} Families and communities may explain the same account differently. We want to preserve those differences with permission and attribution, not vote on a single official version.</p>
      <p class="fine">This is an invitation for future participation, not a working form. No submission, personal data or audio is collected on this preview.</p>
      <p class="tale-discuss"><strong>Talk about the story:</strong> What did the characters think they knew? What could another viewpoint add? Who would you ask next?</p>
      <p><a href={"/community/share/?story="+e.slug}>Practise telling another version (private demo; nothing is submitted) →</a></p>
      <a href="/tales/">Explore other tales →</a>
      {relatedFigure&&<p><a href={relatedFigure.href}>Explore different accounts of {relatedFigure.name} →</a></p>}
      <p class="kicker">THE NEXT TALE</p>
      <p><a href={`/tales/${nextStory.slug}/`}>{nextStory.name} →</a></p>
      <p class="fine">This written version has no matching narrated audio yet.</p>
    </footer>
  </article>
</Site>
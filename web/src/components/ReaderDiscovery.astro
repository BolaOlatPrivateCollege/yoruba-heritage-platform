---
import {livingEpisodes,episodeHref} from '../lib/living-episodes';
import {heritageFigures,figureHref} from '../lib/heritage-figures';
import {approvedFigureIllustrations} from '../lib/approved-figure-illustrations';
import {existsSync} from 'node:fs';
import {resolve} from 'node:path';
const figures=heritageFigures.filter(f=>!['oba','oya'].includes(f.slug)&&approvedFigureIllustrations[f.slug]&&existsSync(resolve(process.cwd(),'public','images',approvedFigureIllustrations[f.slug]!.filename)));
const stories=livingEpisodes.map(e=>({title:e.name,href:episodeHref(e.slug),deck:e.deck,meta:Math.ceil(e.body.words/200)+' min read · '+e.genre}));
---
<section class="wrap discovery section" aria-labelledby="discovery-title">
  <p class="kicker">A LITTLE CULTURE EVERY DAY</p>
  <h2 id="discovery-title">Discover something today.</h2>
  <p class="muted">A story and a cultural figure to explore. The selections rotate daily on this device; the complete library is always available.</p>
  <div class="discovery-grid">
    <div class="discovery-panel" data-daily-list="story">
      {stories.map((s,i)=><article data-daily-item hidden={i!==0}>
        <p class="kicker">STORY OF THE DAY</p><h3><a href={s.href}>{s.title}</a></h3><p>{s.deck}</p><p class="fine">{s.meta}</p><a class="text-link" href={s.href}>Read the story →</a>
      </article>)}
      <p><a href="/tales/">All stories →</a></p>
    </div>
    <div class="discovery-panel" data-daily-list="figure">
      {figures.map((f,i)=>{const a=approvedFigureIllustrations[f.slug]!;return <article data-daily-item hidden={i!==0}>
        <p class="kicker">CULTURAL FIGURE OF THE DAY</p><a href={figureHref(f.slug)}><img src={`/images/${a.filename}`} width={a.width} height={a.height} alt={a.alt} loading="lazy" decoding="async"/></a><h3><a href={figureHref(f.slug)}>{f.name}</a></h3><p>{f.role}</p><p class="fine">AI-generated artistic interpretation, not archival evidence.</p><a class="text-link" href={figureHref(f.slug)}>Explore the profile →</a>
      </article>})}
      <p><a href="/figures/">All cultural figures →</a></p>
    </div>
  </div>
  <noscript><p class="fine">A fixed selection is shown without JavaScript.</p></noscript>
</section>
<script>
  const now=new Date();
  const day=Math.floor(Date.UTC(now.getFullYear(),now.getMonth(),now.getDate())/86400000);
  document.querySelectorAll('[data-daily-list]').forEach(list=>{
    const items=Array.from(list.querySelectorAll<HTMLElement>('[data-daily-item]'));
    if(items.length)items.forEach((item,i)=>{item.hidden=i!==((day%items.length)+items.length)%items.length;});
  });
</script>
<style>
.discovery-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.5rem}
.discovery-panel{min-width:0;background:var(--panel);border:1px solid var(--line);padding:clamp(1rem,3vw,2rem)}
.discovery-panel article[hidden]{display:none}
.discovery-panel h3{margin:.8rem 0;font-size:clamp(1.35rem,3vw,2rem)}
.discovery-panel img{width:100%;height:clamp(180px,35vw,330px);object-fit:contain;background:#241f1a}
.discovery-panel>p{border-top:1px solid var(--line);padding-top:1rem;margin-top:1.4rem}
@media(max-width:650px){.discovery-grid{grid-template-columns:1fr}}
</style>

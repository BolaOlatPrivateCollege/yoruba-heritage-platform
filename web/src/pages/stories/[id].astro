---
import Site from '../../layouts/Site.astro';
import StoryParagraph from '../../components/StoryParagraph.astro';
import {stories,storyFor,storyHref,sourcesFor,storyWordCount,readingMinutes,type StoryRecord} from '../../lib/stories';
import {archive} from '../../lib/archive';
import {Image} from 'astro:assets';
import indigoStudy from '../../assets/indigo-study.png';
import '../../styles/stories.css';
export function getStaticPaths(){return stories.map(story=>({params:{id:story.id},props:{story}}));}
interface Props {story:StoryRecord}
const {story:s}=Astro.props;
const next=storyFor(s.next),sources=sourcesFor(s);
---
<Site title={s.title} description={s.deck} active="Stories">
  <article class:list={['story-page',`theme-${s.theme}`]} data-story={s.id}>
    <header class="wrap page-head story-header"><a class="text-link" href="/stories/">← Stories &amp; journeys</a><p class="kicker">{s.place}</p><h1>{s.title}</h1><p class="story-subtitle">{s.subtitle}</p><p class="lead">{s.deck}</p><p class="draft-banner">Editorial research draft · not reviewed for public release</p><p class="fine story-reading-meta" data-word-count={storyWordCount(s)}>{storyWordCount(s)} words · about {readingMinutes(storyWordCount(s))} min read · Version {s.revision}<br/>Claims unreviewed · Rights unknown · Publication approval not granted</p></header>
    {s.theme==='indigo'&&<figure class="wrap editorial-image"><Image src={indigoStudy} alt="Original illustrated study of indigo-coloured folds and cotton threads; no historical cloth or authentic named motif is represented." width={1200} widths={[320,640,900,1200]} sizes="(max-width:650px) calc(100vw - 40px), (max-width:1280px) calc(100vw - 80px), 1200px" format="webp" quality={75} loading="eager"/><figcaption>Original AI-generated editorial illustration · not a photograph, historic textile or authenticated design.</figcaption></figure>}
    <div class="wrap story-layout"><div class="story-body">
      <StoryParagraph paragraph={s.opening} lead/>
      <details class="story-toc"><summary>In this story</summary><nav aria-label="Story sections"><ol>{s.sections.map(section=><li><a href={`#${section.id}`}>{section.title}</a></li>)}<li><a href="#look-closely">Look closely</a></li><li><a href="#tradition-evidence">Tradition and evidence</a></li><li><a href="#read-evidence">Read the evidence</a></li></ol></nav></details>
      {s.sections.map((section,i)=><section class="story-section" id={section.id}><p class="kicker">0{i+1} / {s.sections.length}</p><h2>{section.title}</h2>{section.paragraphs.map(p=><StoryParagraph paragraph={p}/>)}</section>)}
      <aside class="story-look" id="look-closely"><p class="kicker">A DETAIL TO RETURN TO</p><h2>{s.lookCloser.title}</h2><figure class="story-diagram"><img src={`/editorial/${s.illustration}`} alt={s.illustrationAlt} width="1200" height="600" loading="lazy" decoding="async"/><figcaption>Original educational illustration · not a historic object, photograph, site map or authenticated ritual diagram. Simplified for this reading.</figcaption><a class="text-link story-figure-link" href={`/editorial/${s.illustration}`}>Open illustration at full size →</a></figure>{s.lookCloser.paragraphs.map(p=><StoryParagraph paragraph={p}/>)}</aside>
      <section class="story-section" id="tradition-evidence"><h2>Tradition and evidence</h2><StoryParagraph paragraph={s.traditionEvidence}/></section>
      <section class="story-section" id="questions-open"><h2>Questions still open</h2><ul class="open-questions">{s.questions.map(q=><li>{q}</li>)}</ul><p class="fine">Reader reflections · no score or answer key</p></section>
      <section class="story-section" id="voices-needed"><h2>Research voices needed</h2><p class="story-prose">{s.voices}</p><p class="fine">An invitation to a future reviewed research process; no collection of testimony or contact details on this page.</p></section>
      <section class="story-section" id="key-terms"><h2>Words to keep in view</h2><p class="fine">Working glossary · usage is scoped to the cited passages; linguistic review remains pending.</p><dl class="story-glossary">{s.glossary.map(g=><div><dt lang="yo">{g.term}</dt><dd>{g.meaning} <a class="fine" href={`#evidence-${g.citation.sourceId}-${g.citation.passageId}`}>Term source</a></dd></div>)}</dl></section>
      <section class="story-section" id="original-archive"><h2>Explore original archive</h2><p class="fine">Preserved research drafts, unchanged by this story.</p><ol class="story-related">{s.archiveLinks.map(link=>{const a=archive.articles.find(a=>a.id===link.id)!;return <li><a href={`/articles/${a.id}/#section-${link.section}`}>{a.title}</a><p>{link.reason}</p></li>;})}</ol></section>
      <section class="story-section story-evidence" id="read-evidence"><h2>Read the evidence</h2><p>The citations above link to specific inspected passages below. “Inspected” means the identified passage was read during this draft, not that its full source history, accuracy or publication rights have been cleared.</p>
        {sources.map(source=><article class="story-source" id={`evidence-${source.id}`}><p class="kicker">DRAFT SOURCE REGISTER / {source.id}</p><h3><a href={source.url} rel="noreferrer">{source.title}</a></h3><p>{source.publisher} · {source.material}</p><p class="fine">Accessed {source.accessed} · Identified passages inspected · Review unreviewed · Rights unknown</p><p><strong>Scope:</strong> {source.locality}</p><p><strong>Dependency assessment:</strong> {source.johnsonAssessment}</p><p><strong>Rights and limits:</strong> {source.rightsNote}</p><dl>{source.passages.map(p=><div id={`evidence-${source.id}-${p.id}`}><dt>{p.locator}</dt><dd><strong>Supports:</strong> {p.supports}<br/><strong>Does not establish:</strong> {p.limits}</dd></div>)}</dl></article>)}
      </section>
      <nav class="story-next" aria-label="Continue reading"><p class="kicker">ONE STORY OPENS ANOTHER</p><h2><a href={storyHref(next.id)}>{next.title} →</a></h2><p>{next.deck}</p><p class="fine">Editorial research draft · {readingMinutes(storyWordCount(next))} min read</p><a href="/stories/#journeys">Choose another reading journey</a><a href="/articles/">Back to the preserved library</a><a href="#main">Back to the story heading</a></nav>
    </div><aside class="story-margin"><p class="kicker">READ WITH THE SOURCES</p><p>Look closely.<br/>Follow a question.<br/>Keep the context.</p><a href="#read-evidence">Source register ↓</a><a href="#original-archive">Original archive ↓</a><p class="fine">This optional editorial layer does not replace the original article text.</p></aside></div>
  </article>
</Site>

{
  "name": "asa-itan-reading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "prepare:data": "node scripts/prepare.mjs",
    "check": "npm run prepare:data && astro check",
    "build": "npm run prepare:data && astro build",
    "dev": "npm run prepare:data && astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": { "astro": "7.4.13", "zod": "4.6.7" },
  "devDependencies": {
    "@astrojs/check": "0.9.5",
    "typescript": "5.9.3",
    "@types/node": "22.10.0",
    "@playwright/test": "1.65.0",
    "cheerio": "1.2.0"
  }
}

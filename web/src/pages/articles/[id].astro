---
import Site from '../../layouts/Site.astro';
import ArticleContext from '../../components/ArticleContext.astro';
import {archive,articleHref,sourceFor,sourceHref,type ArticleRecord} from '../../lib/archive';
export function getStaticPaths(){return archive.articles.map(article=>({params:{id:article.id},props:{article}}));}
interface Props {article:ArticleRecord}
const {article:a}=Astro.props;
const profile=archive.sacredProfiles.find(p=>p.articleId===a.id);
---
<Site title={a.title} description={a.deck} active="Library"><div class="wrap article-top"><a class="text-link" href="/articles/">← Reading library</a><span>{a.category}</span></div><article class="wrap article-layout">
<div class="article-main"><header class="article-head"><p class="kicker">{a.era??a.category}</p><h1 class="canonical-title">{a.title}</h1><p class="lead canonical-deck">{a.deck}</p><p class="fine">{a.sections.length} sections · Claims unreviewed · Rights unknown</p></header>
<details class="mobile-toc"><summary>In this reading</summary><nav aria-label="Article sections"><ol>{a.sections.map((s,i)=><li><a href={`#section-${i+1}`}>{s.h}</a></li>)}</ol></nav></details>
<aside class="evidence" aria-label="Evidence and limits"><h2>Evidence & limits</h2><p class="evidence-type">{a.evidenceType}</p><p class="evidence-note">{a.evidenceNote}</p><p class="fine">Engineering preservation is not scholarly or publication approval.</p></aside>
{profile&&<aside class="evidence"><h2>Sacred World context</h2><p>{profile.kind}</p><p>{profile.scope}</p><p>{profile.confidence}</p><p>{profile.communityNeeded}</p></aside>}
{a.sections.map((s,i)=><section class="article-section" id={`section-${i+1}`}><p class="kicker">SECTION {String(i+1).padStart(2,'0')}</p><h2 class="section-heading">{s.h}</h2><p class="canonical-body">{s.p}</p><ul class="section-sources" aria-label={`Sources for section ${i+1}`}>{s.sourceIds.map(id=><li><a href={sourceHref(id)}>{sourceFor(id).title}</a></li>)}</ul></section>)}
{a.question&&<aside class="notice reflection"><h2>A question to carry forward</h2><p>{a.question}</p></aside>}
<section class="section bibliography"><h2>Article bibliography</h2><p class="muted">Original article-level source list. Individual sections may cite additional registered sources.</p><ul>{a.sourceIds.map(id=><li><a href={sourceHref(id)}>{sourceFor(id).title}</a><p>{sourceFor(id).institution}</p></li>)}</ul></section><ArticleContext articleId={a.id}/><a class="text-link" href={articleHref(a.id)+'#main'}>Back to article heading ↑</a></div>
<aside class="contents"><nav aria-label="On this page"><p class="kicker">IN THIS READING</p><ol>{a.sections.map((s,i)=><li><a href={`#section-${i+1}`}>{s.h}</a></li>)}</ol></nav><p class="fine">Regional and source limitations are part of the reading.</p></aside></article></Site>

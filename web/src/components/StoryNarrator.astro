---
import '../styles/audio.css';
interface Props {parts:{id:string;label:string}[]}
const {parts}=Astro.props;
---
<section class="story-narrator wrap" aria-labelledby="narrator-title" data-narrator>
  <p class="kicker">AN OPTIONAL WAY TO READ</p><h2 id="narrator-title">Listen to this story.</h2>
  <p>English device-generated voice — not a historical narrator, elder testimony or authenticated Yorùbá pronunciation. This is a reading of an existing research draft.</p>
  <p class="fine" id="narrator-limits">English voices may mispronounce Yorùbá names and mixed-language passages. Only browser-reported local English voices are offered. Device support and voice quality vary; offline operation cannot be guaranteed by this page. No audio starts automatically.</p>
  <p><a href="/learning/pronunciation/">Learn about reviewed Yorùbá pronunciation</a></p>
  <div class="narrator-controls" hidden>
    <div class="narrator-fields"><div><label for="narrator-section">Start at a section</label><select id="narrator-section">{parts.map(p=><option value={p.id}>{p.label}</option>)}</select></div><div><label for="narrator-voice">Local English device voice</label><select id="narrator-voice" aria-describedby="narrator-limits"><option value="">No local English voice available</option></select></div><div><label for="narrator-speed">Playback speed</label><select id="narrator-speed"><option value="0.75">0.75× — slower</option><option value="1" selected>1× — normal</option><option value="1.25">1.25×</option><option value="1.5">1.5× — faster</option></select></div></div>
    <div class="narrator-actions"><button type="button" data-speech="play" disabled>Play</button><button type="button" data-speech="pause" disabled>Pause</button><button type="button" data-speech="resume" disabled>Resume</button><button type="button" data-speech="stop" disabled>Stop</button><button type="button" data-speech="refresh">Check voices</button></div>
    <p class="fine">Reads the visible narrative from the chosen section onward, excluding source registers, navigation and glossary. Changing section, voice or speed stops playback; press Play to restart. Leaving or hiding the page stops it.</p><a class="narrator-jump" href={`#${parts[0]!.id}`}>Read the chosen section</a>
  </div>
  <p class="narrator-status" role="status" aria-live="polite" aria-atomic="true">Device narration needs JavaScript and a supported local English voice. The complete text below remains available.</p>
  <noscript><p>No audio controls are active without JavaScript. Read the story and follow its section links below.</p></noscript>
</section>
<script>import '../lib/narration-client';</script>
